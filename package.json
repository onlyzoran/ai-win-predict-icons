{
  "name": "@onlyzoran/ai-win-predict-icons",
  "version": "0.8.0",
  "description": "React icon components for AI Win Predict (Tabler-style)",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build && tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "build:playground": "vite build --config playground/vite.config.ts",
    "type-check": "tsc --noEmit -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onlyzoran/ai-win-predict-icons.git"
  },
  "homepage": "https://github.com/onlyzoran/ai-win-predict-icons#readme",
  "bugs": {
    "url": "https://github.com/onlyzoran/ai-win-predict-icons/issues"
  },
  "license": "UNLICENSED",
  "keywords": [
    "react",
    "icons",
    "tabler",
    "ai-win-predict"
  ]
}
